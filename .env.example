# ─────────────────────────────────────────────────────────────
# Supabase
# Tableau de bord : https://app.supabase.com
# Project Settings → Data API  (et Project Settings → API Keys)
# ─────────────────────────────────────────────────────────────

# URL du projet, ex. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé "anon" / publishable — peut vivre côté navigateur.
# La sécurité repose sur les règles RLS de la base, pas sur le secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SECRÈTE. Serveur uniquement, contourne la RLS.
# Utilisée seulement par les scripts (seed) ou de futures tâches d'administration.
# Ne jamais l'exposer au client, ne jamais la committer avec une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=
